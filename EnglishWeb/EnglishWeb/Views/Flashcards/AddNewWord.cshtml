@{
    ViewBag.Title = "Add New Word";
}

<h2>Add New Word to Flashcard</h2>

<form method="post" action="@Url.Action("AddNewWord", "Flashcards")">
    <div class="form-group">
        <label>Word:</label>
        <input type="text" name="word" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Meaning:</label>
        <textarea name="meaning" class="form-control" required></textarea>
    </div>
    <button type="submit" class="btn btn-primary mt-2">✔ Add Word</button>
    <a href="@Url.Action("Index", "Flashcards")" class="btn btn-secondary mt-2">← Back</a>
</form>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info mt-3">@TempData["Message"]</div>
}
