@model EnglishWeb.Models.UserVocabularyHistory

@{
    ViewBag.Title = "Flashcard Review";
    var word = ViewBag.CurrentFlashcard as EnglishWeb.Models.UserVocabularyHistory;
    bool showMeaning = ViewBag.ShowMeaning ?? false;
    int totalWords = ViewBag.WordsToReviewCount ?? 0;
}

<div class="container">
    <h2>🧠 Flashcard Review</h2>
    <a href="@Url.Action("AddNewWord", "Flashcards")" class="btn btn-outline-success mb-3">➕ Thêm từ mới</a>

    @if (word != null && word.Vocabulary != null)
    {
        <div class="card mt-4 p-4 border shadow-sm">
            <h3 class="mb-3 text-primary">@word.Vocabulary.Word</h3>

            @* Phát âm (nếu có) *@
            @if (!string.IsNullOrEmpty(word.Vocabulary.PronunciationUrl))
            {
                <audio controls>
                    <source src="@word.Vocabulary.PronunciationUrl" type="audio/mpeg" />
                    Trình duyệt của bạn không hỗ trợ audio.
                </audio>
            }

            @* Ảnh minh họa *@
            @{
                var image = word.Vocabulary.Images?.FirstOrDefault();
            }
            @if (image != null)
            {
                <img src="@image.FilePath" alt="Image for @word.Vocabulary.Word" class="img-thumbnail my-3" style="max-width: 200px;" />
            }

            @if (showMeaning)
            {
                <p><strong>📖 Nghĩa:</strong> @word.Vocabulary.Definition</p>
                <p><strong>💡 Ví dụ:</strong> <em>@word.Vocabulary.Example</em></p>

                <form method="post" action="@Url.Action("RateWord", "Flashcards")">
                    <input type="hidden" name="historyId" value="@word.HistoryId" />
                    <input type="hidden" name="wordId" value="@word.WordId" />
                    <div class="rating">
                        <label class="d-block mb-2">📊 Mức độ nhớ (0 - quên sạch, 5 - nhớ rất rõ):</label>
                        <div class="d-flex flex-wrap">
                            @for (int i = 0; i <= 5; i++)
                            {
                                <button type="submit" name="rating" value="@i" class="btn btn-outline-primary m-1">@i</button>
                            }
                        </div>
                    </div>
                </form>
            }
            else
            {
                <form method="post" action="@Url.Action("ShowMeaning", "Flashcards")">
                    <input type="hidden" name="historyId" value="@word.HistoryId" />
                    <input type="hidden" name="wordId" value="@word.WordId" />
                    <button type="submit" class="btn btn-success mt-3">👁 Hiển thị nghĩa & ví dụ</button>
                </form>
            }
        </div>

        <p class="mt-3">📌 Còn lại: <strong>@totalWords</strong> từ cần ôn tập</p>
    }
    else
    {
        <div class="alert alert-info mt-4">🎉 Bạn đã hoàn thành toàn bộ flashcards hôm nay!</div>
    }

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-warning mt-3">@ViewBag.Message</div>
    }
</div>
