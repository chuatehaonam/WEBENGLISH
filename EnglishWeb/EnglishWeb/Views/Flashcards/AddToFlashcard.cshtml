@model List<EnglishWeb.Models.Vocabulary>

@{
    ViewBag.Title = "Thêm từ vào Flashcard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <h2>🗂️ Thêm từ vào Flashcard</h2>
    
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Flashcards")">Flashcards</a></li>
            <li class="breadcrumb-item active" aria-current="page">Thêm từ</li>
        </ol>
    </nav>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>📝 Từ</th>
                    <th>📖 Định nghĩa</th>
                    <th>💡 Ví dụ</th>
                    <th>🎯 Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var word in Model)
                {
                    <tr>
                        <td><strong>@word.Word</strong></td>
                        <td>@(string.IsNullOrEmpty(word.Definition) ? "Chưa có định nghĩa" : word.Definition)</td>
                        <td><em>@(string.IsNullOrEmpty(word.Example) ? "Chưa có ví dụ" : word.Example)</em></td>
                        <td>
                            @using (Html.BeginForm("AddToFlashcard", "Flashcards", FormMethod.Post))
                            {
                                @Html.Hidden("wordId", word.WordId)
                                <button type="submit" class="btn btn-success btn-sm">
                                    ➕ Thêm vào Flashcard
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <a href="@Url.Action("Index", "Flashcards")" class="btn btn-secondary">
            ← Quay lại Flashcards
        </a>
    </div>
</div>
