@{
    ViewBag.Title = "Generate Paragraphs";
}

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <h2><i class="fas fa-book-open"></i> Generate Paragraphs from Bilingual Books</h2>

            <hr />
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Generate New Paragraph</h5>
                    <p class="card-text">
                        Click one of the buttons below to generate a fresh 50-word paragraph using <strong>DeepSeek AI</strong>.
                        Each paragraph is unique and educational. Results appear instantly above!
                    </p>

                    <div class="row">
                        <div class="col-md-6">
                            <button type="button" id="generateEnglishBtn" class="btn btn-primary btn-lg w-100 mb-2">
                                <i class="fas fa-globe"></i> Generate English Paragraph
                            </button>
                        </div>
                        <div class="col-md-6">
                            <button type="button" id="generateVietnameseBtn" class="btn btn-success btn-lg w-100 mb-2">
                                <i class="fas fa-flag"></i> Tạo Đoạn Văn Tiếng Việt
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div id="resultArea" style="display: none;">
                <div id="successAlert" class="alert alert-success" role="alert" style="display: none;">
                    <i class="fas fa-check-circle"></i> <span id="successMessage"></span>
                </div>

                <div id="errorAlert" class="alert alert-danger" role="alert" style="display: none;">
                    <i class="fas fa-exclamation-triangle"></i> <span id="errorMessage"></span>
                </div>

                <div id="resultCard" class="card mb-4" style="display: none;">
                    <div id="resultHeader" class="card-header text-white" style="color: #ffffff !important;">
                        <h5 style="color:black !important;"><i class="fas fa-file-text"></i> <span id="resultTitle" style="color: #ffffff !important;"></span></h5>
                    </div>
                    <div class="card-body">
                        <div id="resultContent" class="generated-paragraph translatable-content" style="line-height: 1.8; font-size: 16px; text-align: justify; color:black"></div>
                    </div>
                </div>
            </div>

            <!-- Translation Comparison Section -->
            <div class="card mt-4">
                <div class="card-header bg-info text-white">
                    <h5><i class="fas fa-language"></i> So sánh bản dịch của bạn</h5>
                </div>
                <div class="card-body">
                    <p class="card-text">
                        Hãy nhập bản dịch của bạn vào ô bên dưới và AI sẽ so sánh với đoạn văn đã tạo ở trên, đưa ra nhận xét ngắn gọn.
                    </p>

                    <div class="mb-3">
                        <label for="userTranslation" class="form-label  w-100"><strong>Bản dịch của bạn:</strong></label>
                        <textarea id="userTranslation" class="form-control" rows="4"
                                  placeholder="Nhập bản dịch của bạn tại đây... (Tiếng Việt hoặc Tiếng Anh)"
                                  style="border: 2px solid #e9ecef; border-radius: 8px;"></textarea>
                    </div>

                    <button type="button" id="compareTranslationBtn" class="btn btn-info btn-lg" disabled>
                        <i class="fas fa-balance-scale"></i> Check 
                    </button>

                    <div class="mt-3">
                        <small class="text-muted">
                            <i class="fas fa-info-circle"></i>
                            Lưu ý: Bạn cần tạo đoạn văn trước khi sử dụng tính năng so sánh.
                        </small>
                    </div>
                </div>
            </div>

            <!-- Comparison Result -->
            <div id="comparisonResultArea" style="display: none;">
                <div class="card mt-4">
                    <div class="card-header bg-warning text-dark">
                        <h5><i class="fas fa-comments"></i> Nhận xét từ AI</h5>
                    </div>
                    <div class="card-body">
                        <div id="comparisonContent" class="translatable-content ai-response-content" 
                             style="line-height: 1.8; font-size: 16px; user-select: text; cursor: text;"></div>
                    </div>
                    <div class="card-footer">
                        <small class="text-muted">
                            <i class="fas fa-robot"></i> 
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        /* Monochromatic Blue Color Palette */
        --primary-dark: #1e3a5f; /* Darkest blue */
        --primary-medium: #2c5282; /* Medium dark blue */
        --primary-base: #3182ce; /* Base blue */
        --primary-light: #4299e1; /* Light blue */
        --primary-lighter: #63b3ed; /* Lighter blue */
        --primary-lightest: #90cdf4; /* Lightest blue */
        --primary-pale: #bee3f8; /* Very pale blue */
        --primary-subtle: #ebf8ff; /* Subtle blue background */
    }

    .generated-paragraph {
        background-color: var(--primary-subtle);
        padding: 20px;
        border-radius: 10px;
        border-left: 4px solid var(--primary-base);
        box-shadow: 0 2px 4px rgba(49, 130, 206, 0.15);
    }

    .card {
        box-shadow: 0 4px 6px rgba(49, 130, 206, 0.1);
        border: 1px solid var(--primary-pale);
        border-radius: 12px;
    }

    .card-header.bg-primary {
        background: linear-gradient(135deg, var(--primary-base) 0%, var(--primary-dark) 100%) !important;
        border-bottom: none;
        color: #ffffff;
    }

    .card-header.bg-success {
        background: linear-gradient(135deg, var(--primary-light) 0%, var(--primary-medium) 100%) !important;
        border-bottom: none;
        color: #ffffff;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--primary-base) 0%, var(--primary-dark) 100%);
        border: none;
        padding: 12px 24px;
        font-weight: bold;
        transition: all 0.3s ease;
        color: #ffffff;
    }

    .btn-success {
        background: linear-gradient(135deg, var(--primary-light) 0%, var(--primary-medium) 100%);
        border: none;
        padding: 12px 24px;
        font-weight: bold;
        transition: all 0.3s ease;
        color: #ffffff;
    }

    .btn-info {
        background: linear-gradient(135deg, var(--primary-lighter) 0%, var(--primary-base) 100%);
        border: none;
        padding: 12px 24px;
        font-weight: bold;
        transition: all 0.3s ease;
        color: var(--primary-dark);
    }



    .card-header.bg-info {
        background: linear-gradient(135deg, var(--primary-lighter) 0%, var(--primary-base) 100%) !important;
        border-bottom: none;
        color: #ffffff;
    }

    .card-header.bg-warning {
        background: linear-gradient(135deg, var(--primary-lightest) 0%, var(--primary-light) 100%) !important;
        border-bottom: none;
        color: var(--primary-dark);
    }

    .container {
        margin-top: 30px;
        background: linear-gradient(135deg, #ffffff 0%, var(--primary-subtle) 100%);
        border-radius: 15px;
        padding: 30px;
        box-shadow: 0 8px 25px rgba(49, 130, 206, 0.08);
    }

    .alert {
        border: none;
        border-radius: 10px;
    }

    .alert-success {
        background: linear-gradient(135deg, var(--primary-subtle) 0%, var(--primary-pale) 100%);
        border-left: 4px solid var(--primary-light);
        color: var(--primary-dark);
    }

    .alert-danger {
        background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
        border-left: 4px solid #ef4444;
        color: #991b1b;
    }

    h2 {
        color: var(--primary-dark);
        font-weight: 700;
    }

    h5 {
        font-weight: 600;
    }

    .form-control {
        border: 2px solid var(--primary-pale);
        border-radius: 8px;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: var(--primary-base);
            box-shadow: 0 0 0 0.2rem rgba(49, 130, 206, 0.25);
        }

    .text-muted {
        color: var(--primary-medium) !important;
    }

    body {
        background: linear-gradient(135deg, #f7fafc 0%, var(--primary-subtle) 100%);
        min-height: 100vh;
    }

    .translatable-content {
        user-select: text;
    }
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function() {
        var currentParagraph = null; // Store current generated paragraph
        var currentParagraphType = null; // Store paragraph type (english/vietnamese)

        // Generate English Paragraph
        $('#generateEnglishBtn').click(function() {
            generateParagraph('english', $(this));
        });

        // Generate Vietnamese Paragraph
        $('#generateVietnameseBtn').click(function() {
            generateParagraph('vietnamese', $(this));
        });

        // Compare Translation
        $('#compareTranslationBtn').click(function() {
            compareTranslation($(this));
        });

        // Enable/disable compare button when user types
        $('#userTranslation').on('input', function() {
            var hasText = $(this).val().trim().length > 0;
            var hasGeneratedParagraph = currentParagraph !== null;
            $('#compareTranslationBtn').prop('disabled', !(hasText && hasGeneratedParagraph));
        });

        function generateParagraph(type, button) {
            // Hide previous results
            hideAllAlerts();

            // Show loading state
            var originalText = button.html();
            var loadingText = type === 'english'
                ? '<i class="fas fa-spinner fa-spin"></i> Generating English paragraph...'
                : '<i class="fas fa-spinner fa-spin"></i> Đang tạo đoạn văn tiếng Việt...';

            button.html(loadingText).prop('disabled', true);

            // Scroll to top to show result
            $('html, body').animate({scrollTop: 0}, 300);

            // Make AJAX call
            var url = type === 'english'
                ? '@Url.Action("GenerateEnglishParagraph", "Pragraph")'
                : '@Url.Action("GenerateVietnameseParagraph", "Pragraph")';

            $.post(url)
                .done(function(response) {
                    if (response.success) {
                        showSuccess(response);
                    } else {
                        showError(response.error);
                    }
                })
                .fail(function() {
                    var errorMsg = type === 'english'
                        ? 'Failed to generate English paragraph'
                        : 'Không thể tạo đoạn văn tiếng Việt';
                    showError(errorMsg);
                })
                .always(function() {
                    // Restore button
                    button.html(originalText).prop('disabled', false);
                });
        }

        function showSuccess(response) {
            // Store current paragraph and type for comparison
            currentParagraph = response.content;
            currentParagraphType = response.type.toLowerCase();

            $('#resultArea').show();
            $('#successMessage').text(response.message);
            $('#successAlert').show();

            // Set result content
            $('#resultContent').html(response.content.replace(/\n/g, '<br>'));

            // Set header and footer based on type
                         if (response.type === 'English') {
                 $('#resultHeader').removeClass('bg-success').addClass('bg-primary');
                 $('#resultTitle').text('AI Generated English Paragraph');
                 $('#resultFooter').text('Generated by DeepSeek AI');
             } else {
                 $('#resultHeader').removeClass('bg-primary').addClass('bg-success');
                 $('#resultTitle').text('Đoạn Văn AI Tiếng Việt');
                 $('#resultFooter').text('Được tạo bởi DeepSeek AI');
             }

            $('#resultCard').show();

            // Reinitialize translator for new generated content
            if (window.reinitializeTranslator) {
                window.reinitializeTranslator();
            }

            // Enable compare button if user has typed something
            var hasUserText = $('#userTranslation').val().trim().length > 0;
            $('#compareTranslationBtn').prop('disabled', !hasUserText);
        }

        function showError(message) {
            $('#resultArea').show();
            $('#errorMessage').text(message);
            $('#errorAlert').show();
        }

        function compareTranslation(button) {
            var userTranslation = $('#userTranslation').val().trim();

            if (!userTranslation || !currentParagraph) {
                showError('Vui lòng tạo đoạn văn trước và nhập bản dịch của bạn.');
                return;
            }

            // Hide previous comparison results
            $('#comparisonResultArea').hide();

            // Show loading state
            var originalText = button.html();
            button.html('<i class="fas fa-spinner fa-spin"></i> Đang so sánh...').prop('disabled', true);

            // Make AJAX call
            $.post('@Url.Action("CompareTranslation", "Pragraph")', {
                originalText: currentParagraph,
                userTranslation: userTranslation
            })
                .done(function (response) {
                    if (response.success) {
                        $('#comparisonContent').html(
                            '<div class="alert alert-success" role="alert">' +
                            response.content.replace(/\n/g, '<br>') +
                            '</div>'
                        );

                        $('#comparisonResultArea').fadeIn('fast');

                        if (window.reinitializeTranslator) {
                            window.reinitializeTranslator();
                        }

                        $('html, body').animate({
                            scrollTop: $('#comparisonResultArea').offset().top - 100
                        }, 500);
                    } else {
                        showError(response.error || 'Không thể so sánh bản dịch');
                    }
                })
            .fail(function(xhr, status, error) {
                showError('Lỗi kết nối khi so sánh bản dịch');
            })
            .always(function() {
                // Restore button
                button.html(originalText).prop('disabled', false);
            });
        }

        function hideAllAlerts() {
            $('#successAlert, #errorAlert, #resultCard').hide();
        }
    });
</script>
