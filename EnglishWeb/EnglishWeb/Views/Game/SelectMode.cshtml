@{
    ViewBag.Title = "Select Difficulty";
    int lessonId = (int)ViewBag.LessonId;
}

<h2 class="text-center">🎯 Select Difficulty</h2>
<div class="text-center mt-4">
    <a href="@Url.Action("Play", "Game", new { lessonId = lessonId, mode = "easy" })" class="btn btn-success btn-lg m-2">🟢 Easy</a>
    <a href="@Url.Action("Play", "Game", new { lessonId = lessonId, mode = "hard" })" class="btn btn-danger btn-lg m-2">🔴 Hard (7 seconds)</a>
</div>
