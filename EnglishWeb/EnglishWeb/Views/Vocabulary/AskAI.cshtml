@{
    ViewBag.Title = "AI Assistant - Trợ lý AI";
}

<div class="container mt-4">
    <h2>🤖 Trợ lý AI - DeepSeek</h2>
    
    <div class="row">
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header">
                    <h5>💬 Hỏi đáp với AI</h5>
                </div>
                <div class="card-body">
                    <div class="form-group">
                        <label for="questionInput">Câu hỏi của bạn:</label>
                        <textarea id="questionInput" class="form-control" rows="3" placeholder="Hãy đặt câu hỏi..."></textarea>
                    </div>
                    <button id="askBtn" class="btn btn-primary">Hỏi AI</button>
                    <div id="aiResponse" class="mt-3" style="display:none;">
                        <div class="alert alert-info">
                            <strong>Câu trả lời:</strong>
                            <div id="responseText"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header">
                    <h5>🔄 Dịch thuật</h5>
                </div>
                <div class="card-body">
                    <div class="form-group">
                        <label for="translateInput">Văn bản cần dịch:</label>
                        <textarea id="translateInput" class="form-control" rows="3" placeholder="Nhập văn bản cần dịch..."></textarea>
                    </div>
                    <div class="form-group">
                        <label for="direction">Hướng dịch:</label>
                        <select id="direction" class="form-control">
                            <option value="en-vi">Anh → Việt</option>
                            <option value="vi-en">Việt → Anh</option>
                        </select>
                    </div>
                    <button id="translateBtn" class="btn btn-success">Dịch</button>
                    <div id="translateResponse" class="mt-3" style="display:none;">
                        <div class="alert alert-success">
                            <strong>Bản dịch:</strong>
                            <div id="translationText"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row">
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header">
                    <h5>📚 Tạo bài học</h5>
                </div>
                <div class="card-body">
                    <div class="form-group">
                        <label for="topicInput">Chủ đề:</label>
                        <input type="text" id="topicInput" class="form-control" placeholder="VD: Animals, Food, Family...">
                    </div>
                    <div class="form-group">
                        <label for="levelSelect">Trình độ:</label>
                        <select id="levelSelect" class="form-control">
                            <option value="beginner">Cơ bản</option>
                            <option value="intermediate">Trung bình</option>
                            <option value="advanced">Nâng cao</option>
                        </select>
                    </div>
                    <button id="lessonBtn" class="btn btn-warning">Tạo bài học</button>
                    <div id="lessonResponse" class="mt-3" style="display:none;">
                        <div class="alert alert-warning">
                            <strong>Bài học:</strong>
                            <div id="lessonText"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header">
                    <h5>❓ Tạo câu hỏi trắc nghiệm</h5>
                </div>
                <div class="card-body">
                    <div class="form-group">
                        <label for="quizTopicInput">Chủ đề:</label>
                        <input type="text" id="quizTopicInput" class="form-control" placeholder="VD: Grammar, Vocabulary...">
                    </div>
                    <div class="form-group">
                        <label for="questionCount">Số câu hỏi:</label>
                        <select id="questionCount" class="form-control">
                            <option value="3">3 câu</option>
                            <option value="5" selected>5 câu</option>
                            <option value="10">10 câu</option>
                        </select>
                    </div>
                    <button id="quizBtn" class="btn btn-danger">Tạo câu hỏi</button>
                    <div id="quizResponse" class="mt-3" style="display:none;">
                        <div class="alert alert-danger">
                            <strong>Câu hỏi trắc nghiệm:</strong>
                            <div id="quizText"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    // Hỏi đáp với AI
    $('#askBtn').click(function() {
        var question = $('#questionInput').val();
        if (!question.trim()) {
            alert('Vui lòng nhập câu hỏi!');
            return;
        }
        
        $(this).prop('disabled', true).text('Đang xử lý...');
        
        $.post('@Url.Action("GetAIResponse", "Vocabulary")', 
            { question: question },
            function(data) {
                if (data.success) {
                    $('#responseText').text(data.response);
                    $('#aiResponse').show();
                } else {
                    alert('Lỗi: ' + data.error);
                }
            }
        ).always(function() {
            $('#askBtn').prop('disabled', false).text('Hỏi AI');
        });
    });
    
    // Dịch thuật
    $('#translateBtn').click(function() {
        var text = $('#translateInput').val();
        var direction = $('#direction').val();
        
        if (!text.trim()) {
            alert('Vui lòng nhập văn bản cần dịch!');
            return;
        }
        
        $(this).prop('disabled', true).text('Đang dịch...');
        
        $.post('@Url.Action("TranslateText", "Vocabulary")', 
            { text: text, direction: direction },
            function(data) {
                if (data.success) {
                    $('#translationText').text(data.translation);
                    $('#translateResponse').show();
                } else {
                    alert('Lỗi: ' + data.error);
                }
            }
        ).always(function() {
            $('#translateBtn').prop('disabled', false).text('Dịch');
        });
    });
    
    // Tạo bài học
    $('#lessonBtn').click(function() {
        var topic = $('#topicInput').val();
        var level = $('#levelSelect').val();
        
        if (!topic.trim()) {
            alert('Vui lòng nhập chủ đề!');
            return;
        }
        
        $(this).prop('disabled', true).text('Đang tạo...');
        
        $.post('@Url.Action("GenerateLesson", "Vocabulary")', 
            { topic: topic, level: level },
            function(data) {
                if (data.success) {
                    $('#lessonText').html(data.lesson.replace(/\n/g, '<br>'));
                    $('#lessonResponse').show();
                } else {
                    alert('Lỗi: ' + data.error);
                }
            }
        ).always(function() {
            $('#lessonBtn').prop('disabled', false).text('Tạo bài học');
        });
    });
    
    // Tạo câu hỏi
    $('#quizBtn').click(function() {
        var topic = $('#quizTopicInput').val();
        var count = $('#questionCount').val();
        
        if (!topic.trim()) {
            alert('Vui lòng nhập chủ đề!');
            return;
        }
        
        $(this).prop('disabled', true).text('Đang tạo...');
        
        $.post('@Url.Action("GenerateQuiz", "Vocabulary")', 
            { topic: topic, numberOfQuestions: count },
            function(data) {
                if (data.success) {
                    $('#quizText').html(data.quiz.replace(/\n/g, '<br>'));
                    $('#quizResponse').show();
                } else {
                    alert('Lỗi: ' + data.error);
                }
            }
        ).always(function() {
            $('#quizBtn').prop('disabled', false).text('Tạo câu hỏi');
        });
    });
});
</script> 